{% extends "common/templates/layouts/govuk-layout.njk" %}

{% block content %}
  <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>
  {% if filterPrototype %}
    <p class="govuk-body">Filtered to prototype: <strong>{{ filterPrototype }}</strong>
      (<a class="govuk-link" href="/trail/{{ trailType }}">clear filter</a>)</p>
  {% endif %}

  {% if items.length %}
    <table class="govuk-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th class="govuk-table__header" scope="col">Title</th>
          <th class="govuk-table__header" scope="col">Date</th>
          <th class="govuk-table__header" scope="col">Prototype</th>
          <th class="govuk-table__header" scope="col">Status / type</th>
          <th class="govuk-table__header" scope="col">File</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for item in items %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">{{ item.title }}</td>
            <td class="govuk-table__cell">{{ item.date }}</td>
            <td class="govuk-table__cell">{{ item.prototype or '—' }}</td>
            <td class="govuk-table__cell">{{ item.status or item.type or '—' }}</td>
            <td class="govuk-table__cell"><code>{{ item.repoPath }}</code></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="govuk-body">No records yet.</p>
  {% endif %}

  <p class="govuk-body" style="margin-top: 30px">
    <a class="govuk-link" href="/trail">Design trail</a>
    ·
    <a class="govuk-link" href="/">Dashboard</a>
  </p>
{% endblock %}
